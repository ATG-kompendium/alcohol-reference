---
import vodka from "../../data/vodka.json";
import whisky from "../../data/whisky.json";
import rum from "../../data/rum.json";
import tequila from "../../data/tequila.json";
import gin from "../../data/gin.json";
import liqueur from "../../data/liqueur.json";
import brandy from "../../data/brandy.json";
import polish from "../../data/polish.json";

import "../../styles/main.css";

export async function getStaticPaths() {

  const products = [
    ...vodka,
    ...whisky,
    ...rum,
    ...tequila,
    ...gin,
    ...liqueur,
    ...brandy,
    ...polish
  ];

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{product.name}</title>
    <base href={import.meta.env.BASE_URL} />
  </head>

  <body data-category={product.category}>
    <a class="back" href="./">← Powrót</a>

    <div class="card">
      <div class="header">

  <div class="image">
    <div class="main-image">
      <img
        id="mainProductImage"
        src={product.variants?.[0]?.image ?? product.image}
        alt={product.name}
        loading="lazy"
      />

      {product.variants && (
        <p id="mainImageLabel" class="variant-label">
          {product.variants[0]?.type}
        </p>
      )}
    </div>
  </div>

  <div class="right-column">

    <div class="info">

      <h1>{product.name}</h1>
      <p class="subtitle">{product.subtitle}</p>

      <ul class="meta">
        <li><strong>Kategoria:</strong> {product.category}</li>
        <li><strong>Kraj:</strong> {product.country}</li>
        <li><strong>ABV:</strong> {product.abv}</li>

        {product.rawMaterial && (
          <li><strong>Surowiec:</strong> {product.rawMaterial}</li>
        )}

        {product.maturation && (
          <li><strong>Dojrzewanie:</strong> {product.maturation}</li>
        )}
      </ul>

    </div>

    {product.variants && product.variants.length > 1 && (
      <div class="variants-panel">

        <p class="variants-title">
          Dostępne warianty
        </p>

        <div class="thumbnails">
          {product.variants.map((v) => (
            <img
              src={v.image}
              alt={v.type}
              class="thumb"
              data-image={v.image}
              data-label={v.type}
            />
          ))}
        </div>

      </div>
    )}

  </div>

</div>

      {product.whenToOffer && (
        <section>
          <h2>Dla kogo</h2>
          <ul>
            {product.whenToOffer.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      {product.howToPresent && (
  <section>
    <h2>Jak prezentować</h2>

    {Array.isArray(product.howToPresent)
      ? product.howToPresent.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      : <p>{product.howToPresent}</p>
    }

  </section>
)}

{/* 🆕 CROSS-SELLING */}
      {product.crossSell && (
        <section>
          <h2>Co warto dorzucić</h2>
          <ul>
            {product.crossSell.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      {/* 🆕 COCKTAILS */}
      {product.cocktails && (
        <section>
          <h2>W jakich drinkach można użyć</h2>
          <ul>
            {product.cocktails.map((drink) => (
              <li>{drink}</li>
            ))}
          </ul>
        </section>
      )}

      {product.alternatives && (
        <section>
          <h2>Słuzy alternatywą do</h2>
          <ul>
            {product.alternatives.map((alt) => (
              <li>{alt}</li>
            ))}
          </ul>
        </section>
      )}

      {product.nose && (
        <section>
          <h2>W zapachu</h2>
          <p>{product.nose}</p>
        </section>
      )}

            {product.salesTip && (
  <section class="tip">
    <h2>Tip sprzedażowy</h2>
    <ul>
      {product.salesTip.map((tip) => (
        <li>{tip}</li>
      ))}
    </ul>
  </section>
)}

{product.packaging && (
  <section>
    <h2>Dostępne opakowania</h2>
    <div class="packaging-grid">
      {product.packaging.map((p) => (
        <div class="pack-item">
          <img src={p.image} alt={p.name} />
          <p class="pack-name">{p.name}</p>
          {p.note && <p class="pack-note">{p.note}</p>}
        </div>
      ))}
    </div>
  </section>
)}

    </div>
<script>
  const thumbs = document.querySelectorAll(".thumb");
  const mainImage = document.getElementById("mainProductImage");
  const mainLabel = document.getElementById("mainImageLabel");

  thumbs.forEach((thumb) => {
    thumb.addEventListener("click", () => {

      // убираем выделение у всех миниатюр
      thumbs.forEach(t => t.classList.remove("active"));

      // выделяем выбранную
      thumb.classList.add("active");

      // меняем изображение
      mainImage.src = thumb.dataset.image;

      // меняем подпись
      if (mainLabel) {
        mainLabel.textContent = thumb.dataset.label;
      }
    });
  });

  // сразу выделяем первую миниатюру
  if (thumbs.length) {
    thumbs[0].classList.add("active");
  }
</script>
  </body>
</html>