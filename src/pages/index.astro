---


import "../styles/main.css";


const BASE = import.meta.env.BASE_URL;

---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ATG kompendium</title>
  <link rel="icon" type="image/png+xml" href={`${BASE}favicon.png`} />
</head>
<body>

<h1>ATG kompendium</h1>

<input id="search" type="text" placeholder="Szukaj produktu..." autocomplete="off" />
<ul id="results"></ul>

<script>
const BASE = import.meta.env.BASE_URL;

const input = document.getElementById("search");
const results = document.getElementById("results");

let products = null;

function normalize(text) {
  return (text || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/ł/g, "l")
    .replace(/Ł/g, "L")
    .replace(/æ/g, "ae")
    .replace(/Æ/g, "AE")
    .replace(/œ/g, "oe")
    .replace(/Œ/g, "OE")
    .replace(/ß/g, "ss")
    .toLowerCase();
}

input.placeholder = "Ładowanie bazy...";
input.disabled = true;

fetch(BASE + "products.json")
  .then(r => r.json())
  .then(data => {
    products = data;

    input.disabled = false;
    input.placeholder = "Szukaj produktu...";
  });

function render(list) {
  results.innerHTML = "";
  if (!list.length) return;

  list.forEach(p => {
    const li = document.createElement("li");
    const a = document.createElement("a");
    a.href = BASE + "products/" + p.slug + "/";
    a.textContent = p.name;
    li.appendChild(a);
    results.appendChild(li);
  });
}

input.addEventListener("input", e => {
  if (!products) return;   // ← ВАЖНО

  const q = normalize(e.target.value.trim());
if (!q) return render([]);

const filtered = products.filter(p =>
  normalize(p.name).includes(q) ||
  normalize(p.category).includes(q) ||
  normalize(p.country).includes(q) ||
  normalize(p.rawMaterial).includes(q) ||
  p.keywords?.some(k => normalize(k).includes(q))
);

  render(filtered);
});
</script>

</body>
</html>